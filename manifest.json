{
  "manifest_version": 3,
  "name": "Blip",
  "version": "1.0.1",
  "description": "Blip turns your web browser into an 'edit-in-place' web page editor and mini-CMS.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Toggle Blip"
  },
  "host_permissions": ["https://api.github.com/*", "https://my.remaphq.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidebar.html", "sidebar.js", "sidebar.css", "config.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
